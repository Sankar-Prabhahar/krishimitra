{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/tts",
      "destination": "https://krishi-final.onrender.com/api/tts"
    },
    {
      "source": "/audio/:path*",
      "destination": "https://krishi-final.onrender.com/audio/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://krishi-final.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
